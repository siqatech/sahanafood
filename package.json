{
  "name": "sahana-food",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS multi-tenant, multimarca y multisucursal para dark kitchens y restaurantes con delivery",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm migrations:check && pnpm test",
    "migrations:check": "node infra/scripts/check-migrations.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "argon2"
    ],
    "overrides": {
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "multer": ">=2.2.0",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    }
  }
}
