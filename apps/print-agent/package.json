{
  "name": "@sahana/print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente local de impresión ESC/POS (ADR-0008). Un navegador no habla con impresoras térmicas: este servicio sí, y sin internet.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
