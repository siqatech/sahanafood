{
  "name": "@sahana/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS — monolito modular de Sahana Food",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/workers/main.js",
    "worker:dev": "node --import @swc-node/register/esm-register --watch src/workers/main.ts",
    "migrate": "node --import tsx src/database/migrate.ts",
    "seed": "node --import tsx src/database/seed.ts",
    "demo:tenant": "node --import @swc-node/register/esm-register src/database/demo-tenant.ts",
    "test": "vitest run",
    "test:integration": "vitest run",
    "seed:load": "node --import @swc-node/register/esm-register src/database/seed-load.ts",
    "seed:shop": "node --import @swc-node/register/esm-register src/database/seed-shop.ts",
    "test:golden": "vitest run src/__tests__/ai-golden-suite.test.ts",
    "bootstrap:roles": "node --import @swc-node/register/esm-register src/database/bootstrap-roles.ts",
    "sync:roles": "node --import @swc-node/register/esm-register src/database/sync-roles.ts",
    "provision": "node --import @swc-node/register/esm-register src/database/provision.ts",
    "setup:business": "node --import @swc-node/register/esm-register src/database/setup-business.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sahana/ai-prompts": "workspace:*",
    "@sahana/domain": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.2.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.5"
  }
}
