{
  "name": "@sahana/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS — monolito modular de Sahana Food",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node --import tsx src/database/migrate.ts",
    "seed": "node --import tsx src/database/seed.ts",
    "demo:tenant": "node --import tsx src/database/demo-tenant.ts",
    "test": "vitest run",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@sahana/domain": "workspace:*",
    "bullmq": "^5.34.10",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.2.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
