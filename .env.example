# Copia a .env y ajusta. NUNCA subas .env con secretos reales al repo.

# --- Postgres ---
POSTGRES_USER=sahana
POSTGRES_PASSWORD=sahana_dev
POSTGRES_DB=sahana
POSTGRES_PORT=5432

# Conexiones de la app (rol SIN BYPASSRLS) y de migraciones (dueño del esquema).
# Pooling en MODO TRANSACCIÓN: el tenant se fija con SET LOCAL por transacción.
DATABASE_URL=postgres://sahana_app:sahana_app_dev@localhost:5432/sahana
MIGRATION_DATABASE_URL=postgres://sahana_migrator:sahana_migrator_dev@localhost:5432/sahana

# --- Redis (caché, colas BullMQ, pub/sub de WebSockets) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Correo de prueba (Mailhog) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# --- API ---
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# --- Auth (JWT corto + refresh rotativo) ---
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh
# Clave maestra de cifrado de credenciales de conector (RN-INT-04), >=32 chars.
# Derivada por tenant con HKDF; rotarla obliga a recifrar lo ya guardado.
CREDENTIALS_MASTER_KEY=cambia-esto-en-produccion-credenciales-32

JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Worker (procesos de fondo) ---
# El relay va rápido porque de él depende que la cocina vea el pedido
# (SLO: visible en KDS < 5 s). El barrido de aceptación va cada minuto: sus
# plazos son de minutos y consultarlo más a menudo solo gasta conexiones.
WORKER_OUTBOX_INTERVAL_MS=1000
WORKER_ACCEPTANCE_INTERVAL_MS=60000
WORKER_OUTBOX_BATCH_SIZE=100

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
