# Sahana Food — variables de entorno.
#
#   cp .env.example .env    y rellenar lo marcado como OBLIGATORIO.
#
# El proceso VALIDA esto al arrancar y **no arranca** si falta algo o si en
# producción quedan los valores de desarrollo (`config.ts`). Fallar en el
# arranque es preferible a servir en un estado indefinido: un JWT firmado con
# el secreto de ejemplo lo puede firmar cualquiera que haya leído el
# repositorio, y las credenciales de conector de todos los tenants se descifran
# con la clave maestra.
#
# Generar cada secreto con:  openssl rand -base64 48

# ---------------------------------------------------------------- OBLIGATORIO

# Superusuario de Postgres. Solo lo usa el contenedor de la base para crearse a
# sí mismo; ni la API ni el worker se conectan con él.
POSTGRES_SUPERUSER=sahana
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=sahana

# Conexión de la APLICACIÓN. Rol SIN BYPASSRLS: es lo que hace que el
# aislamiento por tenant sea del motor y no del código (ADR-0002). Si aquí se
# pone el superusuario, RLS deja de aplicar y cualquier consulta ve todo.
DATABASE_URL=postgres://sahana_app:CAMBIAR@postgres:5432/sahana

# Conexión de MIGRACIONES. Dueño del esquema, tampoco superusuario: que el
# migrador no pueda saltarse RLS es lo que impide que una migración se lleve
# datos de un tenant a otro por descuido.
MIGRATION_DATABASE_URL=postgres://sahana_migrator:CAMBIAR@postgres:5432/sahana

# Clave maestra de la que se derivan (HKDF) las claves por tenant que cifran las
# credenciales de conector (RN-INT-04). Mínimo 32 caracteres.
# ROTARLA OBLIGA A RECIFRAR lo ya guardado: no se cambia sin plan.
CREDENTIALS_MASTER_KEY=

# Firma de tokens. Dos secretos DISTINTOS: con uno solo, un token de refresco
# robado sirve como token de acceso.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ------------------------------------------------------------------ OPCIONAL

REDIS_URL=redis://redis:6379
LOG_LEVEL=info

# Dónde escuchan los contenedores en el HOST.
#
# `127.0.0.1` por defecto, y es deliberado: delante va un proxy con TLS
# (Caddy, nginx o el del proveedor). Publicar en `0.0.0.0` deja la API abierta a
# internet sin cifrado, y por ahí viajan tokens de sesión.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# La tienda habla con la API por la red interna de Docker. Solo se cambia si la
# API vive en otra máquina.
SAHANA_API_URL=http://api:3000

# Dominio del PANEL de gestión. Ponlo.
#
# Vacío = el panel se sirve en cualquier host, incluidos los dominios de las
# tiendas de tus clientes: `polleria.pe/panel` enseñaría la pantalla de acceso
# de la plataforma dentro de una tienda ajena. No hay fuga de datos —el tenant
# sale del token— pero un formulario de acceso donde nadie lo espera es donde
# se pescan contraseñas. Con esto puesto, en los demás hosts responde 404.
SAHANA_PANEL_HOST=

# Colector OTLP para trazas. Sin él, el tracing no se activa (no falla).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Dónde vive la página pública de seguimiento, sin barra final. Es lo que se
# manda por WhatsApp al salir el pedido: sin esto el aviso se envía igual, pero
# SIN enlace, y el cliente vuelve a llamar para preguntar dónde está su comida.
# Si la marca tiene dominio propio verificado se usa el suyo y esto es solo el
# respaldo.
PUBLIC_TRACKING_BASE_URL=http://demo.localhost:3001

# Imágenes a desplegar. En un servidor se apuntan al registro y a un TAG FIJO,
# nunca a `latest`: revertir es volver a poner el tag anterior, y con `latest`
# no hay tag anterior al que volver (T5.35).
# SAHANA_API_IMAGE=ghcr.io/siqatech/sahana-api:2026.08.08-1
# SAHANA_WEB_IMAGE=ghcr.io/siqatech/sahana-web:2026.08.08-1

# ------------------------------------------------ Contraseñas de los roles
#
# Las lee `infra/docker/init/01-roles.sh` al CREAR el volumen de la base. En
# desarrollo tienen valor por defecto; el compose de producción las EXIGE,
# porque el valor por defecto está en el repositorio y por tanto es público.
# Cambiarlas después de crear el volumen no basta: hay que hacer ALTER ROLE.
SAHANA_APP_PASSWORD=
SAHANA_MIGRATOR_PASSWORD=
SAHANA_SUPPORT_PASSWORD=

# --------------------------------------------------- Solo desarrollo local
#
# Los usa `infra/docker/docker-compose.yml`, no el de producción.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ------------------------------------------- Cadencia de los procesos de fondo
#
# Los valores por defecto están razonados en `apps/api/src/config/config.ts`.
# Se tocan para diagnosticar, no para afinar a ciegas.
# WORKER_OUTBOX_INTERVAL_MS=1000
# WORKER_ACCEPTANCE_INTERVAL_MS=60000
# WORKER_BILLING_INTERVAL_MS=30000
# WORKER_INGESTION_INTERVAL_MS=1000
# WORKER_REFUND_INTERVAL_MS=60000
# WORKER_SATURATION_INTERVAL_MS=30000
