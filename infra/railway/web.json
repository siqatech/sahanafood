{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/Dockerfile.web",
    "watchPatterns": [
      "/apps/web/**",
      "/docs/38-api-de-pedidos.md",
      "/infra/docker/**",
      "/infra/railway/**",
      "/.dockerignore",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/packages/**"
    ]
  },
  "deploy": {
    "startCommand": "node apps/web/server.js",
    "healthcheckPath": "/api/salud",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
