{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/Dockerfile.api",
    "watchPatterns": [
      "/apps/api/**",
      "/infra/migrations/**",
      "/infra/docker/**",
      "/infra/railway/**",
      "/.dockerignore",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/packages/**"
    ]
  },
  "deploy": {
    "startCommand": "node dist/main.js",
    "preDeployCommand": "node dist/database/migrate.js && node dist/database/sync-roles.js",
    "healthcheckPath": "/api/v1/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
