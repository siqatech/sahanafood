{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/Dockerfile.api",
    "watchPatterns": [
      "/apps/api/**",
      "/infra/migrations/**",
      "/infra/docker/**",
      "/infra/railway/**",
      "/.dockerignore",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/packages/**"
    ]
  },
  "deploy": {
    "startCommand": "node dist/database/seed-shop.js",
    "restartPolicyType": "NEVER"
  }
}
