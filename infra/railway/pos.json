{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/Dockerfile.pos",
    "watchPatterns": [
      "/apps/pos/**",
      "/infra/docker/**",
      "/infra/railway/**",
      "/.dockerignore",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/packages/**"
    ]
  },
  "deploy": {
    "startCommand": "/docker-entrypoint.sh nginx -g 'daemon off;'",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
