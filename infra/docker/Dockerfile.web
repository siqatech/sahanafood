# Tienda web de Sahana Food (Next.js).
#
# Construcción desde la RAÍZ del repositorio:
#   docker build -f infra/docker/Dockerfile.web -t sahana/web .

FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/print-agent/package.json apps/print-agent/
COPY packages/domain/package.json packages/domain/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ai-prompts/package.json packages/ai-prompts/
# Certificado de una CA corporativa, OPCIONAL. Ver la explicación completa en
# `Dockerfile.api`: va como ARG y no como secreto de BuildKit porque el
# constructor de Railway solo admite `--mount=type=cache`.
#
#   docker build --build-arg CA_BUNDLE_B64="$(base64 -w0 /ruta/ca.crt)" ...
ARG CA_BUNDLE_B64=""
RUN sh -c 'if [ -n "$CA_BUNDLE_B64" ]; then echo "$CA_BUNDLE_B64" | base64 -d > /tmp/ca-bundle.crt; export NODE_EXTRA_CA_CERTS=/tmp/ca-bundle.crt; fi; pnpm install --frozen-lockfile --ignore-scripts'

FROM deps AS build
WORKDIR /app
COPY . .
# El dominio se compila ANTES: la tienda formatea importes con `Money`, y ese
# cálculo no se duplica en el navegador — es la regla de «cálculo solo en
# @sahana/domain», que es lo que impide que la tienda y la caja cobren distinto.
RUN pnpm --filter @sahana/domain build \
  && pnpm --filter @sahana/web build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

USER node

# Salida autónoma: el servidor y solo los módulos que usa.
COPY --chown=node:node --from=build /app/apps/web/.next/standalone ./
COPY --chown=node:node --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --chown=node:node --from=build /app/apps/web/public ./apps/web/public

EXPOSE 3001

# La tienda resuelve la marca por el `Host` del visitante, así que la sonda va
# por IP y SIN nombre: pedirle a la sonda que use un dominio de cliente ataría
# la salud del contenedor a que ese cliente siga siendo cliente. Por eso la
# sonda es su propia ruta y no `/`, que sin `Host` conocido responde según haya
# o no una tienda dada de alta — el alta de un cliente, no la salud del proceso.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/salud').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
