{
  "name": "@sahana/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Lógica de dominio compartida (servidor + PWA offline): Money, cálculo de totales/IGV, máquina de estados. Se compila una vez y corre idéntica en ambos lados (ADR-0006).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
